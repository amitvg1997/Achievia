@startuml Achievia Component Diagram

!define RECTANGLE class

package "Achievia Android Application" {
    
    package "Presentation Layer" {
        [MainActivity] as MainActivity
        [AchieviaNavGraph] as NavGraph
        [Screen] as ScreenEnum
        
        package "UI Screens" {
            [LoginScreen] as LoginScreen
            [RegisterScreen] as RegisterScreen
            [GoalsScreen] as GoalsScreen
            [GoalDetailScreen] as GoalDetailScreen
            [GoalInputScreen] as GoalInputScreen
            [FriendsScreen] as FriendsScreen
            [NotificationsScreen] as NotificationsScreen
            [SettingsScreen] as SettingsScreen
        }
        
        package "UI Theme" {
            [AchieviaTheme] as Theme
            [Color] as ColorTheme
            [Typography] as Typography
        }
    }
    
    package "Data Layer" {
        [GoalRepository] as Repository
    }
    
    package "Domain Layer" {
        [User] as UserModel
        [Goal] as GoalModel
        [Task] as TaskModel
    }
    
    package "Android Framework" {
        [Jetpack Compose] as Compose
        [Navigation Component] as Navigation
        [StateFlow] as StateFlow
        [Coroutines] as Coroutines
    }
}

' Relationships
MainActivity --> NavGraph : uses
MainActivity --> Theme : applies
NavGraph --> ScreenEnum : references
NavGraph --> LoginScreen : navigates to
NavGraph --> RegisterScreen : navigates to
NavGraph --> GoalsScreen : navigates to
NavGraph --> GoalDetailScreen : navigates to
NavGraph --> GoalInputScreen : navigates to
NavGraph --> FriendsScreen : navigates to
NavGraph --> NotificationsScreen : navigates to
NavGraph --> SettingsScreen : navigates to

LoginScreen --> Repository : reads/writes
RegisterScreen --> Repository : reads/writes
GoalsScreen --> Repository : observes goals
GoalDetailScreen --> Repository : reads/updates
GoalInputScreen --> Repository : creates/updates
FriendsScreen --> Repository : reads shared goals
NotificationsScreen --> Repository : reads notifications

Repository --> GoalModel : manages
Repository --> TaskModel : manages
Repository --> UserModel : manages
Repository --> StateFlow : emits

GoalsScreen --> GoalModel : displays
GoalDetailScreen --> GoalModel : displays
GoalDetailScreen --> TaskModel : displays
GoalInputScreen --> GoalModel : creates/edits
GoalInputScreen --> TaskModel : creates/edits

LoginScreen --> Compose : uses
RegisterScreen --> Compose : uses
GoalsScreen --> Compose : uses
GoalDetailScreen --> Compose : uses
GoalInputScreen --> Compose : uses
FriendsScreen --> Compose : uses
NotificationsScreen --> Compose : uses
SettingsScreen --> Compose : uses

NavGraph --> Navigation : uses
Repository --> Coroutines : uses

note right of Repository
  Singleton object managing
  in-memory state with StateFlow
  Currently uses dummy data
end note

note right of NavGraph
  Handles navigation between
  all screens using Jetpack
  Navigation Compose
end note

@enduml

