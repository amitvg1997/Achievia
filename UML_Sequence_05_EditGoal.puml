@startuml Edit_Goal_Flow

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 60

title Edit Goal Flow

actor User
participant "GoalsScreen" as Goals
participant "AchieviaNavGraph" as Nav
participant "GoalInputScreen" as Input
participant "GoalRepository" as Repo

User -> Goals: Click edit icon on goal card
Goals -> Nav: onNavigateToEditGoal(goalId)
activate Nav
Nav -> Input: Navigate to EditGoal route\nwith goalId parameter
activate Input
Input -> Repo: getGoal(goalId)
activate Repo
Repo --> Input: Return existing Goal
deactivate Repo
Input --> User: Pre-fill form with goal data

User -> Input: Modify title/description
User -> Input: Add/remove tasks
User -> Input: Click "Save Changes"
Input -> Repo: updateGoal(updatedGoal)
activate Repo
Repo -> Repo: Update StateFlow
Repo --> Input: Goal updated
deactivate Repo

Input -> Nav: onNavigateBack()
deactivate Input
Nav -> Goals: Return to GoalsScreen
activate Goals
Goals -> Repo: StateFlow emits update
activate Repo
Repo --> Goals: Updated goal in list
deactivate Repo
Goals --> User: Display updated goal card
deactivate Goals
deactivate Nav

@enduml

