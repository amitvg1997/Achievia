@startuml View_Goal_Log_Hours_Flow

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 60

title View Goal Details & Log Hours Flow

actor User
participant "GoalsScreen" as Goals
participant "AchieviaNavGraph" as Nav
participant "GoalDetailScreen" as Detail
participant "GoalRepository" as Repo
participant "Task Model" as Task

User -> Goals: Click on goal card
Goals -> Nav: onNavigateToGoalDetail(goalId)
activate Nav
Nav -> Detail: Navigate with goalId parameter
activate Detail
Detail -> Repo: getGoal(goalId)
activate Repo
Repo --> Detail: Return Goal object
deactivate Repo
Detail --> User: Display goal details\nand task list

User -> Detail: Click "Log Hours" on task
Detail -> Detail: Show LogHoursDialog
User -> Detail: Enter hours worked
User -> Detail: Click "Log Hours" button
Detail -> Task: Calculate updated loggedHours
activate Task
Task --> Detail: Updated task
deactivate Task
Detail -> Detail: Update goal.tasks list
Detail -> Repo: updateGoal(updatedGoal)
activate Repo
Repo -> Repo: Update StateFlow
Repo --> Detail: Goal updated
deactivate Repo

Detail --> User: Display updated task progress
deactivate Detail
deactivate Nav

' Background update to GoalsScreen
Goals -> Repo: StateFlow emits update
activate Repo
Repo --> Goals: Updated goal progress
deactivate Repo
Goals --> User: Update goal card progress indicator

@enduml

